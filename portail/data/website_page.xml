<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Page website « Demande de congés » embarquée dans le module :
         créée automatiquement à l'installation (plus rien à recréer à la
         main chez un nouveau client). noupdate="1" : jamais réécrite lors
         des mises à jour du module, pour ne pas écraser les modifications
         faites ensuite dans le Website Builder.
         NB : la signature anti-falsification du formulaire
         (website_form_signature) n'a PAS à être stockée ici — Odoo
         l'injecte au rendu de la page (website/tools.py), calculée avec le
         secret de chaque base. L'email de notification (email_to) reste un
         placeholder à configurer chez chaque client.
         Le menu du site est créé par le post_init_hook (voir __init__.py) :
         un menu par site web existant, impossible en XML statique. -->
    <data noupdate="1">

        <record id="view_demande_de_conges" model="ir.ui.view">
            <field name="name">Demande de congés</field>
            <field name="type">qweb</field>
            <field name="key">portail.demande_de_conges</field>
            <field name="arch" type="xml">
                <t t-name="portail.demande_de_conges">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure oe_empty"><section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001" data-snippet="s_website_form" data-name="Formulaire" style="background-image: none;">
                        <div class="container">
                            <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="message" data-success-page="/contactus-thank-you">
                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                    
                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="char"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="o2ezmkbkovl1"><span class="s_website_form_label_content">Nom &amp;amp; Prénom</span><span class="s_website_form_mark"> *</span></label><div class="col-sm"><input class="form-control s_website_form_input" type="text" name="Nom &amp; Prénom" required="1" placeholder="" id="o2ezmkbkovl1" data-fill-with="name" readonly="readonly"/></div></div></div>
                                    
                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="email">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oub62hlfgjwf">
                                                <span class="s_website_form_label_content o_default_snippet_text">Votre e-mail</span>
                                                
                                            <span class="s_website_form_mark"> *</span></label>
                                            <div class="col-sm">
                                                <input class="form-control s_website_form_input" type="email" name="email_from" required="" data-fill-with="email" readonly="readonly" id="oub62hlfgjwf"/>
                                            </div>
                                        </div>
                                    </div><div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="date"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oax23z9hqgob"><span class="s_website_form_label_content">Date de début</span><span class="s_website_form_mark"> *</span></label><div class="col-sm"><div class="s_website_form_date input-group date"><input type="text" class="form-control datetimepicker-input s_website_form_input" name="Date de début" placeholder="" id="oax23z9hqgob" data-fill-with="undefined" required=""/><div class="input-group-text cursor-pointer"><i class="fa fa-calendar"/></div></div></div></div></div><div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="date"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oegwke3yxwbu"><span class="s_website_form_label_content">Date de fin</span><span class="s_website_form_mark">  *</span></label><div class="col-sm"><div class="s_website_form_date input-group date"><input type="text" class="form-control datetimepicker-input s_website_form_input" name="Date de fin" required="1" placeholder="" id="oegwke3yxwbu" data-fill-with="undefined"/><div class="input-group-text cursor-pointer"><i class="fa fa-calendar"/></div></div></div></div></div><div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="many2one"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ob36o4mma1fl"><span class="s_website_form_label_content">Type de congé</span><span class="s_website_form_mark">                                                          *</span></label><div class="col-sm"><select class="form-select s_website_form_input" name="Type de congé" required="1" id="ob36o4mma1fl"><t t-foreach="request.env['hr.leave.type'].sudo().search([('portail_published', '=', True)], order='id')" t-as="portail_lt"><option t-att-value="portail_lt.name" t-out="portail_lt.portail_label or portail_lt.name"/></t></select></div></div></div>
                                    
                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required s_website_form_field_hidden" data-type="char"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oyqq788sgkke"><span class="s_website_form_label_content">Sujet</span><span class="s_website_form_mark"> *</span></label><div class="col-sm"><input class="form-control s_website_form_input" type="text" name="subject" required="" placeholder="" id="oyqq788sgkke" data-fill-with="undefined" value="Demande de congés"/></div></div></div>
                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ofw21dff1016"><span class="s_website_form_label_content">Description</span><span class="s_website_form_mark">       *</span></label><div class="col-sm"><textarea class="form-control s_website_form_input" name="Description" required="1" placeholder="" id="ofw21dff1016" rows="3"/></div></div></div>
                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px"><span class="s_website_form_label_content"/></label><div class="col-sm"><input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@yourcompany.example.com"/></div></div></div><div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="binary"><div class="row s_col_no_resize s_col_no_bgcolor"><label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ojustificatif1"><span class="s_website_form_label_content">Justificatif</span></label><div class="col-sm"><input type="file" class="form-control s_website_form_input" name="Justificatif" multiple="multiple" accept="application/pdf,image/jpeg,image/png,.doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" id="ojustificatif1"/><div class="form-text text-muted">Facultatif : document justifiant la demande (certificat, etc.) — PDF, JPEG, PNG ou Word, 5 Mo maximum.</div></div></div></div><div class="mb-0 py-2 col-12 s_website_form_submit" data-name="Submit Button">
                                        <div style="width: 200px;" class="s_website_form_label"/>
                                        <a href="#" role="button" class="btn btn-primary s_website_form_send o_default_snippet_text">Soumettre</a>
                                        <span id="s_website_form_result"/>
                                    </div>
                                </div>
                            </form><div class="s_website_form_end_message d-none"><div class="oe_structure"><section class="s_text_block pt64 pb64 o_colored_level o_cc o_cc2" data-snippet="s_text_block" style="background-image: none;"><div class="container"><h2 class="text-center"><span class="fa fa-check-circle" style="color: rgb(107, 165, 74);"/> Merci pour votre demande de congé<br/></h2><p class="text-center">&amp;nbsp;Votre demande de congé e été soumise avec succès. Elle sera traitées sous peu.<br/></p></div></section></div></div>
                        </div>
                    </section></div>
                    </t>
                </t>
            </field>
        </record>

        <record id="page_demande_de_conges" model="website.page">
            <field name="view_id" ref="view_demande_de_conges"/>
            <field name="url">/demande-de-conges</field>
            <field name="is_published" eval="True"/>
            <field name="visibility">connected</field>
        </record>


        <!-- Adresse RH qui reçoit les notifications du formulaire de congés.
             Modifiable sans technicien : Paramètres > Technique >
             Paramètres système > portail.email_notification_rh -->
        <record id="param_email_notification_rh" model="ir.config_parameter">
            <field name="key">portail.email_notification_rh</field>
            <field name="value">info@yourcompany.example.com</field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Section « Missions » dans Paramètres généraux -->
    <record id="res_config_settings_view_form_gm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.gestion.mission</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Missions" string="Missions"
                     name="gestion_mission"
                     logo="/gestion_mission/static/description/icon.png">
                    <block title="Ordres de mission" name="gm_block">
                        <setting string="Avance avant départ (%)"
                                 help="Pourcentage du total dû proposé comme avance à la soumission (0 à 100). Commun à toutes les sociétés.">
                            <field name="gm_avance_pct" class="o_light_label"
                                   style="width: 6rem;"/>
                        </setting>
                        <setting string="Nom du signataire"
                                 company_dependent="1"
                                 help="Imprimé dans le bloc signature de l'ordre de mission et de la fiche de décompte (propre à chaque société). Laisser vide pour n'imprimer que la fonction.">
                            <field name="gm_dg_name"/>
                        </setting>
                        <setting string="Fonction du signataire"
                                 company_dependent="1">
                            <field name="gm_dg_fonction"/>
                        </setting>
                    </block>
                    <block title="Imputation comptable" name="gm_block_imputation">
                        <setting string="Service émetteur" company_dependent="1"
                                 help="En-tête de la fiche d'imputation, sous le nom de la banque (ex. « BADF / SCH »).">
                            <field name="gm_imput_service"/>
                        </setting>
                        <setting string="Libellé du visa" company_dependent="1"
                                 help="Mention imprimée en bas de la fiche (ex. « VISA DU SERVICE DU CAPITAL HUMAIN »).">
                            <field name="gm_imput_visa"/>
                        </setting>
                        <setting string="Code agence du siège" company_dependent="1"
                                 help="Code agence porté par la ligne de charge au débit.">
                            <field name="gm_imput_agence_siege" style="width: 8rem;"/>
                        </setting>
                        <setting string="Compte de charge (perdiems)" company_dependent="1"
                                 help="Compte débité pour les indemnités journalières, et son intitulé.">
                            <field name="gm_imput_compte_charge" style="width: 14rem;"/>
                            <field name="gm_imput_libelle_charge" class="o_light_label"/>
                        </setting>
                        <setting string="Compte des frais à justifier" company_dependent="1"
                                 help="Compte débité pour les autres frais (carburant, péage...), et son intitulé.">
                            <field name="gm_imput_compte_justifier" style="width: 14rem;"/>
                            <field name="gm_imput_libelle_justifier" class="o_light_label"/>
                        </setting>
                    </block>
                    <block title="Qui peut initier une demande (portail)" name="gm_block_create">
                        <setting string="Les employés créent leurs demandes"
                                 help="L'employé crée et soumet ses propres demandes de mission depuis le portail. Décoché : il ne fait que suivre les demandes créées pour lui.">
                            <field name="gm_portal_employee_can_create"/>
                        </setting>
                        <setting string="Les chefs créent pour leurs collaborateurs"
                                 help="Un supérieur hiérarchique crée une demande au nom d'un collaborateur direct depuis le portail : brouillon que l'agent complète et soumet, ou soumission directe. La RH peut toujours créer depuis le backend, quel que soit le réglage.">
                            <field name="gm_portal_chef_can_create"/>
                        </setting>
                        <setting string="Chaque missionnaire ne tire que sa propre ligne"
                                 help="Depuis le portail, un simple membre télécharge un « décompte individuel » ne portant que ses montants. Le chef de mission et les valideurs continuent de recevoir la fiche complète : ils répondent du dossier et statuent sur le total du groupe. Décoché, tout membre voit la fiche complète.">
                            <field name="gm_decompte_individuel"/>
                        </setting>
                    </block>
                    <block title="Retour de mission" name="gm_block_retour">
                        <setting string="Exiger les visas de départ et de retour"
                                 help="À la déclaration du retour, le chef de mission joint le document visé au départ ET celui visé au retour (feuille de route tamponnée, ordre de mission visé sur place...). Sans ces deux pièces, le retour ne peut pas être déclaré. Décoché, rien ne change. Le réglage est photographié à la soumission : l'activer n'impose rien aux missions déjà parties.">
                            <field name="gm_visa_exige"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Raccourci dans Missions > Configuration (réservé aux admins :
         l'écran Paramètres exige les droits d'administration). -->
    <record id="action_gm_config_settings" model="ir.actions.act_window">
        <field name="name">Paramètres</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'gestion_mission'}</field>
    </record>
    <menuitem id="menu_gm_settings" name="Paramètres"
              parent="menu_gm_config" action="action_gm_config_settings"
              sequence="99" groups="base.group_system"/>

</odoo>
